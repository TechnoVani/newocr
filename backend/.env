# DB_CONNECTION_LIMIT=5
# DB_CONNECT_TIMEOUT_MS=10000
# DB_USER=notion_ops
# DB_PASSWORD=Notion@ops26
# DB_NAME=notion_ops

DB_HOST=localhost
DB_PORT=3306
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
DB_USER=root
DB_PASSWORD=
DB_NAME=nib

