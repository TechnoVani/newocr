# Use development locally and production on the deployed API server.
APP_ENV=development

# Both modes live in this single file. config/env.js selects the active values.
DEV_APP_URL=http://localhost:5173
DEV_API_URL=http://localhost:5000
DEV_ALLOW_PRIVATE_NETWORK_ORIGINS=true

PROD_APP_URL=https://app.example.com
PROD_API_URL=https://www.ops.technovani.com
PROD_ALLOW_PRIVATE_NETWORK_ORIGINS=false

DB_HOST=localhost
DB_PORT=3306
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=4h

# Optional locally; strongly recommended on cPanel/shared hosting.
# Use a directory owned by the cPanel account, outside public_html.
# Relative paths resolve from the cPanel account home in production.
# Production example:
# MOTOR_POLICY_STORAGE_ROOT=/home/CPANEL_ACCOUNT/notioninsurance-storage/motorpolicy
# Local override example:
# MOTOR_POLICY_STORAGE_ROOT=storage/motorpolicy
BASE_UPLOAD_PATH=public/uploads

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER must be an active/unrestricted mailbox allowed to send mail.
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Notion Insurance <no-reply@example.com>"
MAIL_TRANSPORT=smtp
# On cPanel/Passenger, use this when outbound SMTP is blocked:
# MAIL_TRANSPORT=auto
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_LOG_ONLY=false

# Backend-only environment file.
